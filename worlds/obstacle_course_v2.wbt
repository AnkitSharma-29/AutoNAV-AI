#VRML_SIM R2023b utf8
import_nodes [
  "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/dji/mavic/protos/Mavic2Pro.proto"
]
WorldInfo { basicTimeStep 8 }
Viewpoint { orientation -0.2 0.7 0.7 1.5; position 15 15 15 }
TexturedBackground {}
TexturedBackgroundLight {}
Floor { size 100 100 }

# The AI Drone
Mavic2Pro {
  translation 0 0 0.1
  controller "drone_orchestrator"
}

# Dense Obstacle Maze
Group {
  children [
    Box { translation 5 5 1; size 2 2 4; appearance PBRAppearance { baseColor 1 0 0 } }
    Box { translation 10 -5 1; size 2 2 4; appearance PBRAppearance { baseColor 0 1 0 } }
    Box { translation 15 0 1; size 5 1 4; appearance PBRAppearance { baseColor 0 0 1 } }
    Box { translation 20 10 1; size 1 10 4; appearance PBRAppearance { baseColor 1 1 0 } }
  ]
}
